{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev --no-audit --no-fund",
  "buildCommand": "npm run hosting:prepare && npm run build && npm run hosting:bundle",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": ".vercel-build/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/cron",
      "dest": "/api/cron"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
