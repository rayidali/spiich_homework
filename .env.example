# Leave these unset for npm run dev to start its own local PostgreSQL.
# Set both when using an existing PostgreSQL server. Compose sets its own URLs.
# DATABASE_URL=postgres://spiich_app:spiich_app_local@127.0.0.1:55432/spiich
# MIGRATION_DATABASE_URL=postgres://spiich:spiich@127.0.0.1:55432/spiich
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Choose gemini or openai. Keys remain on the server; manual accounting needs neither.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Leave empty for the provider default: gemini-3.5-flash-lite or gpt-6-luna.
# Override only with a model available to your own API project.
AI_MODEL=
SEED_DEMO=true

# Short-form category suggestions are configured separately from natural-language entry.
# Choose gemini (default), jev, or the offline reference. Keys stay on the server.
CATEGORY_PROVIDER=gemini
TYPESAFE_API_KEY=

# Optional comparative research; never required by the accounting app.
# Native research database from compose.research.yaml:
# RESEARCH_DB_TRANSPORT=postgres
# RESEARCH_OWNER_URL=postgres://daybook_research_owner:daybook_research_local_only@127.0.0.1:5433/daybook_research
# Optional Python interpreter containing pinned research/wren/requirements.txt:
# RESEARCH_WREN_PYTHON=/absolute/path/to/venv/bin/python

# Shared workspace AI request admission (migration007). Same values on all instances.
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=100
AI_MAX_ACTIVE_REQUESTS=4
AI_REQUEST_LEASE_SECONDS=90
# Selected default. authored is the fixed-report control. adaptive can inspect
# results before choosing a calculation; complete also checks a frozen declaration
# of requested outputs. These changed candidates need fresh live evaluation.
# Both share up to 3 provider attempts, 2 reads, 4 queries and a 40-second budget.
FINANCIAL_CHAT_ROUTE=composable
